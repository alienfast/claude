    "deny": [],
    "ask": [
      "mcp__circleci__run_pipeline"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/private/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-permissions.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scratch-path-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-blind-sleep.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/linear-create-state-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/finish-flow-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-deadline-gate.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scratch-path-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/full-continue.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-heartbeat.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-rewake.sh",
            "timeout": 4200,
            "asyncRewake": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|overloaded|server_error|unknown",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-rewake.sh",
            "timeout": 1500,
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "effort-phase@alienfast-claude": true,
    "spawn-policy@alienfast-claude": true
  },
  "extraKnownMarketplaces": {
    "alienfast-claude": {
      "source": {
        "source": "directory",
        "path": "~/.claude"
      }
    }
  },
  "outputStyle": "concise",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
